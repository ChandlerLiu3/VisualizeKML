<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Coordinate Direction Regression</name>
    <Placemark><name>West</name><Point><coordinates>-0.001,0,100</coordinates></Point></Placemark>
    <Placemark><name>East</name><Point><coordinates>0.001,0,100</coordinates></Point></Placemark>
    <Placemark><name>North</name><Point><coordinates>0,0.001,100</coordinates></Point></Placemark>
    <Placemark><name>South</name><Point><coordinates>0,-0.001,100</coordinates></Point></Placemark>
    <Placemark><name>Origin</name><Point><coordinates>0,0,100</coordinates></Point></Placemark>
    <Placemark>
      <LineString>
        <coordinates>
          -0.001,-0.001,100
          0.001,-0.001,100
          0.001,0.001,100
          -0.001,0.001,100
          -0.001,-0.001,100
        </coordinates>
      </LineString>
    </Placemark>
  </Document>
</kml>
